ac_add_options --enable-application=browser

ac_add_options --disable-crashreporter
ac_add_options --disable-debug
ac_add_options --disable-default-browser-agent
ac_add_options --disable-tests
# Obside auto-update (Gecko MAR): NSS-verified updater on the "release" channel,
# MAR channel obside-release. Maintenance service off; MAR signature verification
# stays ON (deliberately NO --enable-unverified-updates).
ac_add_options --enable-updater
ac_add_options --enable-update-channel=release
ac_add_options --disable-maintenance-service
ac_add_options --enable-nss-mar
export MAR_CHANNEL_ID=obside-release
export ACCEPTED_MAR_CHANNEL_IDS=obside-release
ac_add_options --disable-cargo-incremental
ac_add_options --enable-hardening
ac_add_options --enable-optimize
ac_add_options --enable-release
ac_add_options --enable-rust-simd
ac_add_options --enable-jemalloc

ac_add_options --with-app-name=obside
# %PRODUCT% in the update URL = MOZ_APP_BASENAME (application.ini "Name"); default is
# "Firefox". Set to "Obside" so the endpoint gets .../Obside/... (also names the
# profile dir "Obside", since no MOZ_APP_PROFILE is set).
ac_add_options --with-app-basename=Obside
ac_add_options --with-branding=browser/branding/obside

ac_add_options --with-l10n-base=$PWD/lw/l10n

ac_add_options --enable-bootstrap

export MOZ_REQUIRE_SIGNING=
export MOZILLA_OFFICIAL=1

mk_add_options MOZ_CRASHREPORTER=0
mk_add_options MOZ_DATA_REPORTING=0
mk_add_options MOZ_SERVICES_HEALTHREPORT=0
mk_add_options MOZ_TELEMETRY_REPORTING=0
