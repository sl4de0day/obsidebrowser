+function addScanHistoryEntry(fileName, filePath, risk, details) {
+  debugLog("addScanHistoryEntry started: " + fileName + ", risk: " + risk);
+  let history = [];
+  try {
+    let raw = Services.prefs.getStringPref("obside.security.scan_history", "[]");
+    debugLog("addScanHistoryEntry raw history read: " + raw);
+    history = JSON.parse(raw);
+  } catch (e) {
+    debugLog("addScanHistoryEntry read exception: " + e.message);
+  }
+  history.unshift({
+    fileName,
+    filePath,
+    date: new Date().toLocaleString(),
+    risk,
+    details
+  });
+  if (history.length > 50) {
+    history = history.slice(0, 50);
+  }
+  try {
+    let serialized = JSON.stringify(history);
+    Services.prefs.setStringPref("obside.security.scan_history", serialized);
+    debugLog("addScanHistoryEntry setStringPref success: " + serialized);
+  } catch (e) {
+    debugLog("addScanHistoryEntry write exception: " + e.message);
+  }
+}
