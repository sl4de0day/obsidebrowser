+
+        } catch (err) {
+          if (spinner) {
+            spinner.style.display = "none";
+          }
+          if (scanBtn) {
+            scanBtn.disabled = false;
+          }
+          if (resultLabel) {
+            resultLabel.value = isTR ? "Analiz hatası!" : "Analysis error!";
+            resultLabel.style.color = "#ef4444";
+          }
+          debugLog("Scan Execution Error: " + err);
+        }
+      }
+    });
+  } catch (e) {
+    debugLog("Scan Error: " + e.message);
+  }
+}
