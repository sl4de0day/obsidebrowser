+            let color = "";
+            let displayDetails = result.details;
+
+            if (result.risk === "Dangerous") {
+              riskStr = isTR ? "Risk: Zararlı" : "Risk: Dangerous";
+              color = "#ef4444";
+            } else if (result.risk === "Suspicious") {
+              riskStr = isTR ? "Risk: Şüpheli" : "Risk: Suspicious";
+              color = "#f97316";
+            } else {
+              riskStr = isTR ? "Risk: Güvenli" : "Risk: Safe";
