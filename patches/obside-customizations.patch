+    let tdDate = document.createElementNS("http://www.w3.org/1999/xhtml", "td");
+    tdDate.textContent = entry.date;
+    tr.appendChild(tdDate);
+
+    let tdResult = document.createElementNS("http://www.w3.org/1999/xhtml", "td");
+    let resultSpan = document.createElementNS("http://www.w3.org/1999/xhtml", "span");
+    let riskClass = "risk-safe";
+    let riskText = entry.risk;
+    if (entry.risk === "Dangerous" || entry.risk.includes("Zararlı")) {
+      riskClass = "risk-dangerous";
+      riskText = isTR ? "Zararlı" : "Dangerous";
+    } else if (entry.risk === "Suspicious" || entry.risk.includes("Şüpheli")) {
+      riskClass = "risk-suspicious";
+      riskText = isTR ? "Şüpheli" : "Suspicious";
+    } else {
+      riskText = isTR ? "Güvenli" : "Safe";
+    }
+    resultSpan.className = riskClass;
+    resultSpan.textContent = riskText;
+    tdResult.appendChild(resultSpan);
+    tr.appendChild(tdResult);
+
+    let tdDetails = document.createElementNS("http://www.w3.org/1999/xhtml", "td");
+    tdDetails.textContent = entry.details;
+    tr.appendChild(tdDetails);
+
+    tbody.appendChild(tr);
+  }
