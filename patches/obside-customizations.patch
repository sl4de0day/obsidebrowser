+var gObsideResourcePrefObserver = {
+  observe(subject, topic, data) {
+    if (topic !== "nsPref:changed") return;
+    let key = data;
+    let idbKey = key;
+    if (key === "memory_enabled") idbKey = "memory-enabled";
+    else if (key === "memory_value") idbKey = "memory-value";
+    else if (key === "startup_unpinned") idbKey = "startup-unpinned";
+    else if (key === "startup_pinned") idbKey = "startup-pinned";
+    else if (key === "startup_release_pinned") idbKey = "startup-release-pinned";
+
+    let val;
+    if (key === "memory_enabled" || key === "audio" || key === "pinned" || key === "form" || key === "battery" || key === "online" || key === "startup_unpinned" || key === "startup_pinned" || key === "startup_release_pinned" || key === "enabled") {
+      val = Services.prefs.getBoolPref("obside.resource." + key, false);
+    } else if (key === "memory_value" || key === "period" || key === "number") {
+      val = Services.prefs.getIntPref("obside.resource." + key, 0);
+    } else {
+      return;
+    }
+    saveSmartResourceSetting(idbKey, val);
+  }
+};
+
+function handleSmartResourceWhitelistChange() {
+  const wlTextarea = document.getElementById("obside-resources-whitelist");
+  if (wlTextarea) {
+    let lines = wlTextarea.value.split("\n").map(l => l.trim()).filter(l => l.length > 0);
+    saveSmartResourceSetting("whitelist", lines);
+  }
+}
