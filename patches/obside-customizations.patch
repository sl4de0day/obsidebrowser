+async function loadSmartResourceSettings() {
+  try {
+    const { ExtensionStorageIDB } = ChromeUtils.importESModule("resource://gre/modules/ExtensionStorageIDB.sys.mjs");
+    const { ExtensionParent } = ChromeUtils.importESModule("resource://gre/modules/ExtensionParent.sys.mjs");
+    let extension = ExtensionParent.GlobalManager.getExtension("{c2c003ee-bd69-42a2-b0e9-6f34222cb046}");
+    let items = {};
+    if (extension) {
+      let storagePrincipal = ExtensionStorageIDB.getStoragePrincipal(extension);
+      let db = await ExtensionStorageIDB.open(storagePrincipal);
+      items = await db.get(null) || {};
+    }
+    Services.prefs.setIntPref("obside.resource.period", items["period"] !== undefined ? parseInt(items["period"]) : 600);
+    Services.prefs.setIntPref("obside.resource.number", items["number"] !== undefined ? parseInt(items["number"]) : 6);
+    Services.prefs.setBoolPref("obside.resource.memory_enabled", items["memory-enabled"] !== undefined ? !!items["memory-enabled"] : false);
+    Services.prefs.setIntPref("obside.resource.memory_value", items["memory-value"] !== undefined ? parseInt(items["memory-value"]) : 0);
+    Services.prefs.setBoolPref("obside.resource.audio", items["audio"] !== undefined ? !!items["audio"] : false);
+    Services.prefs.setBoolPref("obside.resource.pinned", items["pinned"] !== undefined ? !!items["pinned"] : false);
+    Services.prefs.setBoolPref("obside.resource.form", items["form"] !== undefined ? !!items["form"] : false);
+    Services.prefs.setBoolPref("obside.resource.battery", items["battery"] !== undefined ? !!items["battery"] : false);
+    Services.prefs.setBoolPref("obside.resource.online", items["online"] !== undefined ? !!items["online"] : false);
+    Services.prefs.setBoolPref("obside.resource.startup_unpinned", items["startup-unpinned"] !== undefined ? !!items["startup-unpinned"] : false);
+    Services.prefs.setBoolPref("obside.resource.startup_pinned", items["startup-pinned"] !== undefined ? !!items["startup-pinned"] : false);
+    Services.prefs.setBoolPref("obside.resource.startup_release_pinned", items["startup-release-pinned"] !== undefined ? !!items["startup-release-pinned"] : false);
+
+    const wl = items["whitelist"] || [];
+    const wlTextarea = document.getElementById("obside-resources-whitelist");
