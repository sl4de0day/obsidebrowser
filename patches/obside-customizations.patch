+          resultLabel.value = isTR ? "Analiz ediliyor..." : "Analyzing...";
+          resultLabel.style.color = "#818cf8";
+        }
+
+        try {
+          const result = await runFileScan(filePath);
+          if (spinner) {
+            spinner.style.display = "none";
+          }
+          if (scanBtn) {
+            scanBtn.disabled = false;
+          }
+
+          if (resultLabel) {
