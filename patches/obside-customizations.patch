+    if (extension) {
+      let storagePrincipal = ExtensionStorageIDB.getStoragePrincipal(extension);
+      let db = await ExtensionStorageIDB.open(storagePrincipal);
+      let items = {};
+      items[key] = value;
+      let changes = await db.set(items);
+      if (changes) {
+        ExtensionStorageIDB.notifyListeners(extension.id, changes);
+      }
+    }
+  } catch (e) {
+    debugLog("saveSmartResourceSetting error: " + e.message);
+  }
+}
