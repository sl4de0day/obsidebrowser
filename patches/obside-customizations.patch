+                displayDetails = "Capa Yetenek: " + displayDetails.substring(6);
+              } else if (displayDetails === "No threats found" || displayDetails === "Capa Clean") {
+                displayDetails = "Temiz (Tehdit Bulunmadı)";
+              }
+            }
+
+            resultLabel.value = `${riskStr} (${displayDetails})`;
+            resultLabel.style.color = color;
