+  .header__search,
+  .header__search-wrap,
+  .header__search-container,
+  .search-wrap,
+  .search-box,
+  .search__box,
+  .search__inner,
+  .search-form__box,
+  .search-form__inner,
+  .search__input-wrapper,
+  .search-form__input-wrapper {
+    background-color: transparent !important;
+    background-image: none !important;
+    background: transparent !important;
+    box-shadow: none !important;
+    border: none !important;
+  }
+
+  /* Remove all ugly separator lines, borders and color corruptions */
+  div, section, header, footer, hr {
+    border-color: transparent !important;
+    box-shadow: none !important;
+  }
+  
+  html {
+    background-color: #000000 !important;
+    position: relative !important;
+    min-height: 100vh !important;
+  }
+
+  html::before {
+    content: "" !important;
+    position: fixed !important;
+    top: -50% !important;
+    left: -50% !important;
+    width: 200% !important;
+    height: 200% !important;
+    z-index: -9999 !important;
+    background:
+      radial-gradient(
+        circle at 20% 30%,
+        rgba(99, 102, 241, 0.08) 0%,
+        transparent 40%
+      ),
+      radial-gradient(
+        circle at 80% 70%,
+        rgba(99, 102, 241, 0.06) 0%,
+        transparent 45%
+      ),
+      radial-gradient(
+        circle at 50% 50%,
+        rgba(99, 102, 241, 0.04) 0%,
+        transparent 35%
+      ) !important;
+    animation: globalGradientMoveDDG 25s ease-in-out infinite !important;
+    pointer-events: none !important;
+  }
+
+  html::after {
+    content: "" !important;
+    position: fixed !important;
+    top: 0 !important;
+    left: 0 !important;
+    right: 0 !important;
+    bottom: 0 !important;
+    z-index: -9998 !important;
+    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.5) 100%) !important;
+    pointer-events: none !important;
+  }
+
+  @keyframes globalGradientMoveDDG {
+    0%,
+    100% {
+      transform: translate(0, 0) rotate(0deg) scale(1);
+    }
+    25% {
+      transform: translate(2%, 3%) rotate(1deg) scale(1.02);
+    }
+    50% {
+      transform: translate(-2%, 2%) rotate(-0.5deg) scale(1);
+    }
+    75% {
+      transform: translate(3%, -2%) rotate(0.5deg) scale(1.01);
+    }
+  }
+
+  /* Glassmorphic Search Result Cards */
+  .react-results--main .result,
+  .result--ad,
+  .module--weather,
+  .module--translation,
+  .module--about,
+  .result.result--ad,
+  .zci,
+  .module,
+  .msg,
+  .serp__results .result,
+  .sidebar .module {
+    background-color: rgba(13, 17, 23, 0.45) !important;
+    backdrop-filter: blur(16px) !important;
+    -webkit-backdrop-filter: blur(16px) !important;
+    border: 1px solid rgba(129, 140, 248, 0.12) !important;
+    border-radius: 14px !important;
+    padding: 16px 20px !important;
+    margin-bottom: 16px !important;
+    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4) !important;
+    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.25s ease, box-shadow 0.25s ease !important;
+  }
+
+  /* Floating hover animations for cards */
+  .react-results--main .result:hover,
+  .result--ad:hover,
+  .zci:hover,
+  .sidebar .module:hover {
+    transform: translateY(-2px) !important;
+    border-color: rgba(99, 102, 241, 0.35) !important;
+    box-shadow: 0 8px 30px rgba(99, 102, 241, 0.2) !important;
+  }
+
+  /* 
+     =========================================
+     PIXEL-PERFECT GLASSMORPHIC SEARCH BAR 
+     (UNIVERSALLY APPLIED TO THE SEARCH FORM)
+     =========================================
+  */
+
+  /* 
+     ==================================================
+     THE ULTIMATE DESTRUCTION OF THE GRAY BOX (NUCLEAR)
+     ==================================================
+     We style ONLY one single outer container with our gorgeous glassmorphism,
+     and force absolute transparency on all nested elements to prevent double-layer opacity!
+  */
+
+  /* Style ONLY the actual outer search box container with our gorgeous glassmorphism */
+  html body .search,
+  html body #search_form,
+  html body .search--header,
+  html body .search-form--header,
+  html body .search-form {
+    background-color: rgba(10, 13, 20, 0.6) !important;
+    backdrop-filter: blur(12px) !important;
+    border: 1px solid rgba(129, 140, 248, 0.2) !important;
+    border-radius: 20px !important;
+    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25) !important;
+  }
+
+  /* Force absolute transparency on all inputs, div wrappers, buttons, and pseudo-elements nested inside the container */
+  html body .search *,
+  html body .search *::before,
+  html body .search *::after,
+  html body #search_form *,
+  html body #search_form *::before,
+  html body #search_form *::after,
+  html body .search--header *,
+  html body .search--header *::before,
+  html body .search--header *::after,
+  html body .search-form--header *,
+  html body .search-form--header *::before,
+  html body .search-form--header *::after,
+  html body .search-form *,
+  html body .search-form *::before,
+  html body .search-form *::after,
+  html body .search-form * {
+    background: transparent !important;
+    background-color: transparent !important;
+    background-image: none !important;
+    border: none !important;
+    border-color: transparent !important;
+    box-shadow: none !important;
+    outline: none !important;
+  }
+
+  /* Make search input text white, remove any backgrounds, and add padding */
+  .search__input,
+  #search_form_input,
+  #search_form_input_homepage,
+  .search-form__input,
+  input[type="text"],
+  input[type="search"] {
+    color: #ffffff !important;
+    background-color: transparent !important;
+    background: transparent !important;
+    border: none !important;
+    box-shadow: none !important;
+    outline: none !important;
+    padding-left: 14px !important;
+  }
+
+  /* Make search button and icons perfectly transparent */
+  .search__button,
+  .search-form__button,
+  .search__clear,
+  .search__icon {
+    background: transparent !important;
+    background-color: transparent !important;
+    border: none !important;
+    box-shadow: none !important;
+    color: #818cf8 !important;
+  }
+}
