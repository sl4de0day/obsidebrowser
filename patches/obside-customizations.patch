+        border-inline-start: 1px solid #6366f1 !important;
+        color: #ffffff !important;
+      }
+
+      .customize-menu .home-section-title {
+        color: #ffffff !important;
+        font-family: 'Space Grotesk', system-ui, sans-serif !important;
+      }
+
+      /* Hide any light/dark theme default wallpapers */
+      .wallpaper-background {
+        display: none !important;
+      }
+
+      /* 5. Hide Wordmark (Obside Text) and Center Logo */
+      .logo-and-wordmark .wordmark,
+      .search-wrapper .logo-and-wordmark .wordmark {
+        display: none !important;
+      }
+
+      .logo-and-wordmark,
+      .search-wrapper .logo-and-wordmark {
+        display: flex !important;
+        justify-content: center !important;
+        align-items: center !important;
+        margin-inline: auto !important;
+        width: 100% !important;
+      }
+
+      .logo-and-wordmark .logo,
+      .search-wrapper .logo-and-wordmark .logo {
+        margin: 0 !important;
+        display: inline-block !important;
+        background-size: 110px !important;
+        height: 110px !important;
+        width: 110px !important;
+      }
+
+      /* 6. Keep Search Bar in the Exact Same Spot When Shortcuts are Disabled */
+      .outer-wrapper:not(:has(.top-site-outer)) .search-wrapper,
+      body:not(:has(.top-site-outer)) .search-wrapper,
+      .outer-wrapper.only-search .search-wrapper {
+        margin-block-start: 15vh !important;
+      }
+
+      /* ==================== ANIMATED BACKGROUND FROM WEBSITE ==================== */
+      .animated-bg {
+        position: fixed;
+        top: 0;
+        left: 0;
+        width: 100%;
+        height: 100%;
+        z-index: -999 !important;
+        overflow: hidden;
+        background: #000000 !important;
+      }
+
+      .animated-bg::before {
+        content: "";
+        position: absolute;
+        top: -50%;
+        left: -50%;
+        width: 200%;
+        height: 200%;
+        background:
+          radial-gradient(
+            circle at 20% 30%,
+            rgba(99, 102, 241, 0.08) 0%,
+            transparent 40%
+          ),
+          radial-gradient(
+            circle at 80% 70%,
+            rgba(99, 102, 241, 0.06) 0%,
+            transparent 45%
+          ),
+          radial-gradient(
+            circle at 50% 50%,
+            rgba(99, 102, 241, 0.04) 0%,
+            transparent 35%
+          );
+        animation: gradientMove 25s ease-in-out infinite;
+      }
+
+      .animated-bg::after {
+        content: "";
+        position: absolute;
+        top: 0;
+        left: 0;
+        right: 0;
+        bottom: 0;
+        background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.5) 100%);
+        pointer-events: none;
+      }
+
+      @keyframes gradientMove {
+        0%,
+        100% {
+          transform: translate(0, 0) rotate(0deg) scale(1);
+        }
+
+        25% {
+          transform: translate(2%, 3%) rotate(1deg) scale(1.02);
+        }
+
+        50% {
+          transform: translate(-2%, 2%) rotate(-0.5deg) scale(1);
+        }
+
+        75% {
+          transform: translate(3%, -2%) rotate(0.5deg) scale(1.01);
+        }
+      }
+
+      /* ==================== FLOATING ORBS FROM WEBSITE ==================== */
+      .orb {
+        position: absolute;
+        border-radius: 50%;
+        filter: blur(100px);
+        opacity: 0.4;
+        animation: float 30s ease-in-out infinite;
+        will-change: transform;
+      }
+
+      .orb-1 {
+        width: 350px;
+        height: 350px;
+        background: linear-gradient(135deg, #6366f1, #6366f1);
+        top: 5%;
+        left: 5%;
+        animation-delay: 0s;
+      }
+
+      .orb-2 {
+        width: 280px;
+        height: 280px;
+        background: linear-gradient(135deg, #818cf8, #6366f1);
+        top: 50%;
+        right: 10%;
+        animation-delay: -10s;
+      }
+
+      .orb-3 {
+        width: 250px;
+        height: 250px;
+        background: linear-gradient(135deg, #515f7e, #6366f1);
+        bottom: 15%;
+        left: 25%;
+        animation-delay: -20s;
+      }
+
+      .orb-4 {
+        width: 180px;
+        height: 180px;
+        background: linear-gradient(135deg, #a5b4fc, #c7d2fe);
+        opacity: 0.2;
+        top: 30%;
+        left: 50%;
+        animation-delay: -5s;
+      }
+
+      @keyframes float {
+        0%,
+        100% {
+          transform: translate(0, 0) scale(1);
+        }
+
+        20% {
+          transform: translate(40px, -30px) scale(1.05);
+        }
+
+        40% {
+          transform: translate(-30px, 40px) scale(0.95);
+        }
+
+        60% {
+          transform: translate(30px, 20px) scale(1.02);
+        }
+
+        80% {
+          transform: translate(-20px, -40px) scale(0.98);
+        }
+      }
+    </style>
